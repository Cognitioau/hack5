{
  "name": "hack5-zombie-hand",
  "version": "0.1.0",
  "private": true,
  "description": "Deliberate browser capture into an Obsidian graveyard, with local semantic retrieval.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "format": "biome format --write src tests scripts *.json *.ts",
    "check:format": "biome format src tests scripts *.json *.ts",
    "check:types": "tsc --noEmit",
    "check:lint": "biome lint src tests scripts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:security": "vitest run tests/security",
    "test:browser": "playwright test",
    "test:inference": "playwright test tests/browser/inference.spec.ts",
    "model:fetch": "node scripts/fetch-model.mjs",
    "build": "node scripts/build.mjs",
    "build:core": "node scripts/build.mjs --core",
    "check:package": "node scripts/check-package.mjs",
    "package": "npm run build && npm run build:core && node scripts/package.mjs",
    "check": "npm run check:types && npm run check:format && npm run check:lint && npm run check:boundaries && npm run test:unit && npm run test:contracts && npm run test:security && npm run build && npm run check:package"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@mediapipe/tasks-vision": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
