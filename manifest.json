{
  "manifest_version": 3,
  "name": "Zombie Brain",
  "description": "Deliberately capture a thought, bury it in Obsidian, and recall it locally.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Zombie Brain: grab this page or your selection",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  }
}
